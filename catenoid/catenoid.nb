Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "[", "t_", "]"}], ":=", 
  RowBox[{"Re", "[", 
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"f", "[", "t", "]"}], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
